# Put credentials in Vercel Environment Variables; never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SITE_URL=https://your-production-domain.example
SITE_NAME=Video Library
SOURCE_BASE_URL=https://mobilexh.live
# Neon Function used to discover HLS manifests/video URLs for playback.
NEON_VIDEO_EXTRACTOR_URL=https://br-super-sound-b5ty7f80-videodebug.compute.c-7.us-east-2.aws.neon.tech/
ASSET_BASE_URL=https://ic-vt-nss.cdnsolutions.media
PER_PAGE=30

# Optional source cookie: raw g_state JSON value (no "g_state=" prefix).
# Store the real value as a Vercel Environment Variable, not in this file.
# SOURCE_COOKIE=

# Temporary secret required to use /api/diagnostics/source-page/<video_id> during debugging.
# Generate a long random value, add it only in Vercel Environment Variables, and remove it after diagnosis.
# STREAM_DIAGNOSTICS_TOKEN=
